#!/bin/bash
# Managed by the universal-robots-ursim SURF component.
# After URSim starts: confirm a pending safety configuration and switch PolyScope to
# Remote Control, so ur_rtde / the ROS driver are accepted. PolyScope has no API for
# either, so this clicks through VNC (screen 1280x800).
# With ursim_start_joints set it then powers the simulated arm on and moves it to that pose.
IP={{ ursim_ip }}
VENV={{ ursim_tools_dir }}/venv
V="$VENV/bin/vncdo -s $IP::5900"
dash() { echo "$1" | timeout 3 nc -q1 $IP 29999 2>/dev/null | tail -1; }
# The first click after a VNC connect is often lost, so every action starts with a warm-up
# click on an empty part of the top bar.
click() { $V move 480 30 pause 0.5 click 1 pause 1 "$@"; }

# Until the safety configuration is confirmed, the controller tells every RTDE client
# "SafetySetup has not been confirmed yet" and ur_rtde cannot start (data sync timeout).
rtde_ok() {
  "$VENV/bin/python" -I - "$IP" <<'PY'
import socket, struct, sys
s = socket.create_connection((sys.argv[1], 30004), timeout=3)
s.sendall(struct.pack(">HBH", 5, ord("V"), 2))
buf = b""
try:
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        buf += chunk
except socket.timeout:
    pass
sys.exit(1 if b"has not been confirmed" in buf else 0)
PY
}

for i in $(seq 1 60); do dash PolyscopeVersion | grep -q URSoftware && break; sleep 5; done
sleep 10

for try in 1 2 3; do
  rtde_ok && break
  echo "URSim: confirming the safety configuration"
  click move 620 670 pause 0.5 move 639 681 pause 0.5 click 1 pause 4
done
rtde_ok || echo "URSim: RTDE still not streaming (confirm the safety configuration in PolyScope)"

remote=0
for try in 1 2 3 4 5; do
  if [ "$(dash 'is in remote control')" = "true" ]; then echo "URSim: Remote Control active"; remote=1; break; fi
  # Top-right Local icon opens the menu; "Remote Control" is the item below it. The menu
  # only takes a click after a few seconds, so the item is clicked in a second session.
  click move 1110 25 pause 0.5 move 1117 32 pause 0.5 click 1 pause 3
  $V move 1040 80 pause 0.5 move 1054 88 pause 0.5 click 1 pause 3
done
if [ "$remote" != 1 ]; then
  echo "URSim: could not switch to Remote Control (do it in PolyScope, top right)"
  exit 1
fi

# URSim always boots in the same pose (0, -90, 90, -90, -90, 0 degrees). In the model of a
# cell that pose can lie inside an obstacle; a planner that validates every motion against
# the cell then refuses the first one, also the way out. So the simulated arm is powered on
# and moved to ursim_start_joints once after every start. Nothing checks this move against a
# cell: that is fine for a simulator and the reason it lives here and not in robot code.
START_Q="{{ ursim_start_joints | default('', true) | string | trim }}"
[ -n "$START_Q" ] || exit 0
"$VENV/bin/python" -I - "$IP" "$START_Q" <<'PY'
import sys, time
from dashboard_client import DashboardClient
from rtde_control import RTDEControlInterface
from rtde_receive import RTDEReceiveInterface

ip = sys.argv[1]
try:
    target = [float(x) for x in sys.argv[2].replace(",", " ").split()]
except ValueError:
    target = []
if len(target) != 6:
    sys.exit("URSim: ursim_start_joints needs six joint angles in rad, got %r" % sys.argv[2])
db = DashboardClient(ip)
db.connect()
db.closeSafetyPopup()
db.powerOn()
time.sleep(1)
db.brakeRelease()
for _ in range(60):
    if "RUNNING" in db.robotmode():
        break
    time.sleep(1)
else:
    sys.exit("URSim: the arm did not reach RUNNING (%s); not moved" % db.robotmode())
rr = RTDEReceiveInterface(ip)
if max(abs(a - b) for a, b in zip(rr.getActualQ(), target)) > 1e-3:
    rc = RTDEControlInterface(ip)
    rc.moveJ(target, 1.0, 1.0)
    rc.stopScript()
    rc.disconnect()
err = max(abs(a - b) for a, b in zip(rr.getActualQ(), target))
if err > 1e-2:
    sys.exit("URSim: start pose not reached (max error %.4f rad)" % err)
print("URSim: arm at the start pose", [round(x, 4) for x in target])
PY
